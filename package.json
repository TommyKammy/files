{
  "name": "files-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test --grep-invert @collabora",
    "test:e2e:collabora": "playwright test --grep @collabora",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "db:migrate:local": "pnpm --filter @files/api exec wrangler d1 migrations apply files-local --local",
    "db:seed:local": "pnpm --filter @files/api exec wrangler d1 execute files-local --local --file scripts/seed-local.sql",
    "db:seed:1m": "node scripts/seed-d1-1m.mjs",
    "db:bench": "node scripts/run-d1-benchmark.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
